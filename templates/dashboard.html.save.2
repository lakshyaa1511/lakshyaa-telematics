{% extends "base.html" %}
{% block title %}Dashboard{% endblock %}
{% block content %}

<div class="container mt-4">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-primary">Your Devices</h2>

    <div class="d-flex">
      <input id="searchBar"
             type="text"
             class="form-control me-2 shadow-sm"
             placeholder="🔍 Search devices...">

      <button class="btn btn-success shadow-sm"
              data-bs-toggle="modal"
              data-bs-target="#addDeviceModal">
        <i class="bi bi-plus-circle"></i> Add Device
      </button>
    </div>
  </div>

  <!-- Devices Grid -->
  <div class="row" id="devicesGrid">
    {% for device in devices %}
    <div class="col-md-4 mb-4 device-card"data-name="{{ device.name|lower }}"data-device-id="{{ device.id }}">
      <div class="card device-card h-100">
        <div class="card-body">

          <!-- Header -->
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="fw-semibold mb-0">{{ device.name }}</h5>

            <span class="status-pill {{ 'online' if device.status == 'online' else 'offline' }}"data-ststus>
              {{ device.status | capitalize }}
            </span>
          </div>

          <!-- Meta -->
          <div class="device-meta mt-2">
            <div class="meta-item">
              <i class="bi bi-hash"></i>
              <span>ID {{ device.id }}</span>
            </div>

            <div class="meta-item">
              <i class="bi bi-clock"></i>
              <span data-last-update>{{ device.lastUpdate | default("Last seen: never", true) }}</span>
            </div>
          </div>

          <!-- Actions -->
          <hr class="my-3">

          <div class="d-flex gap-2">
            <a href="{{ url_for('traccar.map_all', device_id=device.id) }}"
               class="btn btn-sm btn-premium">
              <i class="bi bi-map"></i> Map
            </a>

            {% if device.linked %}
              <a href="{{ url_for('traccar.history', traccar_id=device.id) }}"
                 class="btn btn-sm btn-outline-premium">
                <i class="bi bi-clock-history"></i> History
              </a>
            {% else %}
              <button class="btn btn-sm btn-outline-premium" disabled>
                <i class="bi bi-clock-history"></i> History
              </button>
            {% endif %}

            <button class="btn btn-sm btn-light"
                    data-bs-toggle="modal"
                    data-bs-target="#editDeviceModal{{ device.id }}">
              <i class="bi bi-pencil"></i>
            </button>

            <button class="btn btn-sm btn-light text-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#deleteDeviceModal{{ device.id }}">
              <i class="bi bi-trash"></i>
            </button>
          </div>

        </div>
      </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal fade" id="editDeviceModal{{ device.id }}" tabindex="-1">
      <div class="modal-dialog">
        <form method="POST" action="{{ url_for('edit_device', device_id=device.id) }}">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">Edit Device</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
              <input type="text"
                     class="form-control"
                     name="name"
                     value="{{ device.name }}"
                     required>
            </div>
            <div class="modal-footer">
              <button class="btn btn-warning" type="submit">Save</button>
              <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteDeviceModal{{ device.id }}" tabindex="-1">
      <div class="modal-dialog">
        <form method="POST" action="{{ url_for('delete_device', device_id=device.id) }}">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title text-danger">Delete Device</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
              Are you sure you want to delete <strong>{{ device.name }}</strong>?
            </div>
            <div class="modal-footer">
              <button class="btn btn-danger" type="submit">Delete</button>
              <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            </div>
          </div>
        </form>
      </div>
    </div>

    {% endfor %}
  </div>

  {% if not devices %}
  <div class="alert alert-info text-center">
    No devices yet. Click <b>Add Device</b> to get started.
  </div>
  {% endif %}

</div>

<script>
document.getElementById("searchBar").addEventListener("input", function () {
  let q = this.value.toLowerCase();
  document.querySelectorAll("#devicesGrid > div").forEach(card => {
    card.style.display = card.dataset.name.includes(q) ? "block" : "none";
  });
});
</script>

{% endblock %}
