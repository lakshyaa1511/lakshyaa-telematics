{% extends "base.html" %}
{% block title %}History – {{ device.name }}{% endblock %}

{% block content %}
<div class="container mt-4">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"> Trip History – <span class="text-primary">{{ device.name }}</span></h2>

    <div class="btn-group">
     <button class="btn btn-sm btn-outline-secondary" disabled title="Coming soon">
	CSV
     </button>
     <button class="btn btn-sm btn-outline-secondary" disabled title="Coming soon">
	PDF
     </button>ok
    </div>
  </div>

  <!-- Date / time range -->
  <form id="rangeForm" class="row g-2 mb-3">
    <div class="col-md-4">
      <label class="form-label small mb-1">From</label>
      <input type="datetime-local" id="fromInput" class="form-control form-control-sm">
    </div>
    <div class="col-md-4">
      <label class="form-label small mb-1">To</label>
      <input type="datetime-local" id="toInput" class="form-control form-control-sm">
    </div>
    <div class="col-md-4 d-flex align-items-end">
      <button type="submit" class="btn btn-primary btn-sm w-100">
        Load History
      </button>
    </div>
  </form>

  <!-- Map -->
  <div id="historyMap" style="height: 500px; border-radius: 10px;"></div>

  <!-- Playback controls -->
  <div class="mt-3">
    <label class="small mb-1">Playback</label>
    <input type="range" class="form-range" id="playbackSlider" min="0" max="0" value="0">

    <div class="d-flex align-items-center gap-2 mt-2">
      <button id="playBtn"  class="btn btn-success btn-sm">Play</button>
      <button id="pauseBtn" class="btn btn-warning btn-sm">Pause</button>
      <button id="resetBtn" class="btn btn-secondary btn-sm">Reset</button>
      <span class="ms-2 text-muted small" id="pointInfo"></span>
    </div>
  </div>
</div>

<!-- Leaflet -->
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<script>
  // ---------- Config from Flask ----------
  const TRACCAR_DEVICE_ID = {{ traccar_device_id | tojson }};
  const ROUTE_URL = {{ url_for('traccar.api_traccar_route', device_id=traccar_device_id) | tojson }};

  // ---------- Map setup ----------
  const map = L.map('historyMap').setView([20.5937, 78.9629], 5); // center India-ish

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; OpenStreetMap contributors'
  }).addTo(map);

  let routePoints = [];      // [{lat, lng, time, speed}, ...]
  let routePolyline = null;
  let routeMarker = null;
  let playbackTimer = null;

  const slider    = document.getElementById('playbackSlider');
  const pointInfo = document.getElementById('pointInfo');

  // ---------- Helpers ----------
  function clearRoute() {
    if (routePolyline) {
      map.removeLayer(routePolyline);
      routePolyline = null;
    }
    if (routeMarker) {
      map.removeLayer(routeMarker);
      routeMarker = null;
    }
    routePoints = [];
    slider.value = 0;
    slider.max = 0;
    pointInfo.textContent = '';
  }

  function updateMarker(idx) {
    if (!routePoints.length) return;

    const p = routePoints[idx];
    const latlng = [p.lat, p.lng];

    if (!routeMarker) {
      routeMarker = L.marker(latlng).addTo(map);
    } else {
      routeMarker.setLatLng(latlng);
    }

    pointInfo.textContent =
      `${idx + 1}/${routePoints.length} • ` +
      (p.time ? new Date(p.time).toLocaleString() : '') +
      (p.speed != null ? ` • ${p.speed.toFixed(1)} km/h` : '');
  }

  async function loadRoute(fromIso, toIso) {
  clearRoute();

  const url = ROUTE_URL +
    `?from=${encodeURIComponent(fromIso)}&to=${encodeURIComponent(toIso)}`;

  try {
    const resp = await fetch(url);

    // Check HTTP status first
    if (!resp.ok) {
      let msg = `Failed to load history (HTTP ${resp.status}).`;
      try {
        const payload = await resp.json();
        if (payload && payload.error) {
          msg = payload.error;
        }
      } catch (e) {
        // ignore JSON parse errors
      }
      alert(msg);
      return;
    }

    // Now safely parse JSON
    const data = await resp.json();

    if (!Array.isArray(data) || data.length === 0) {
      alert('No history data for this period.');
      return;
    }

    // Normalize points
    routePoints = data
      .filter(p => p.latitude && p.longitude)
      .map(p => ({
        lat: p.latitude,
        lng: p.longitude,
        time: p.fixTime || p.serverTime || p.deviceTime || null,
        speed: typeof p.speed === 'number' ? p.speed : null
      }));

    if (!routePoints.length) {
      alert('No usable points in this time range.');
      return;
    }

    // Draw polyline
    routePolyline = L.polyline(
      routePoints.map(p => [p.lat, p.lng]),
      { weight: 4, opacity: 0.9 }
    ).addTo(map);

    map.fitBounds(routePolyline.getBounds(), { padding: [40, 40] });

    // Init slider & marker
    slider.max = routePoints.length - 1;
    slider.value = 0;
    updateMarker(0);
  } catch (err) {
    console.error('Error loading route:', err);
    alert('Unexpected error while loading history.');
  }
}

  // ---------- Form + default dates ----------
  const fromInput = document.getElementById('fromInput');
  const toInput   = document.getElementById('toInput');

  function toLocalInputValue(date) {
    const pad = n => String(n).padStart(2, '0');
    return date.getFullYear() + '-' +
           pad(date.getMonth() + 1) + '-' +
           pad(date.getDate()) + 'T' +
           pad(date.getHours()) + ':' +
           pad(date.getMinutes());
  }

  // On load: default to last 24 hours
  window.addEventListener('load', () => {
        const now = new Date();
        const twentyFourHoursAgo = new Date(now.getTime() - 24 * 60 * 60 * 1000);

          fromInput.value = toLocalInputValue(twentyFourHoursAgo);
          toInput.value   = toLocalInputValue(now);

        loadRoute(twentyFourHoursAgo.toISOString(), now.toISOString());
  });

  document.getElementById('rangeForm').addEventListener('submit', (e) => {
    e.preventDefault();

    if (!fromInput.value || !toInput.value) {
      alert('Please select both From and To.');
      return;
    }

    const fromDate = new Date(fromInput.value);
    const toDate   = new Date(toInput.value);

    if (fromDate >= toDate) {
      alert('"From" must be earlier than "To".');
      return;
    }

    loadRoute(fromDate.toISOString(), toDate.toISOString());
  });

  // ---------- Slider + playback ----------
  slider.addEventListener('input', () => {
    const idx = Number(slider.value);
    updateMarker(idx);
  });

  document.getElementById('playBtn').addEventListener('click', () => {
    if (!routePoints.length) return;
    if (playbackTimer) return; // already playing

    playbackTimer = setInterval(() => {
      let idx = Number(slider.value);
      if (idx >= routePoints.length - 1) {
        clearInterval(playbackTimer);
        playbackTimer = null;
        return;
      }
      slider.value = idx + 1;
      updateMarker(idx + 1);
    }, 300);
  });

  document.getElementById('pauseBtn').addEventListener('click', () => {
    if (playbackTimer) {
      clearInterval(playbackTimer);
      playbackTimer = null;
    }
  });

  document.getElementById('resetBtn').addEventListener('click', () => {
    if (playbackTimer) {
      clearInterval(playbackTimer);
      playbackTimer = null;
    }
    slider.value = 0;
    updateMarker(0);
  });
</script>


{% endblock %}
