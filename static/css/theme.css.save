/* ===============================
   PREMIUM DESIGN SYSTEM
   =============================== */

:root {
  /* Brand */
  --primary: #4f46e5;      /* Indigo */
  --primary-soft: #eef2ff;

  /* Neutrals */
  --bg-app: #f8fafc;
  --bg-card: #ffffff;
  --bg-sidebar: #0f172a;

  --text-main: #0f172a;
  --text-muted: #64748b;
  --text-light: #cbd5f5;

  /* Status */
  --success: #16a34a;
  --danger: #dc2626;
  --warning: #f59e0b;

  /* UI */
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;

  --shadow-sm: 0 2px 8px rgba(0,0,0,0.04);
  --shadow-md: 0 8px 24px rgba(0,0,0,0.08);
}
.card-premium {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  border: none;
}
.btn-premium {
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  color: #fff;
  border: none;
  border-radius: 10px;
  padding: 8px 16px;
  font-weight: 500;
  transition: all 0.25s ease;
}

.btn-premium:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 20px rgba(79, 70, 229, 0.35);
  color: #fff;
}

.btn-outline-premium {
  border: 1px solid #4f46e5;
  color: #4f46e5;
  background: transparent;
  border-radius: 10px;
  padding: 8px 16px;
  transition: all 0.25s ease;
}

.btn-outline-premium:hover {
  background: #4f46e5;
  color: #fff;
}
.btn-light {
  border-radius: 10px;
  width: 38px;
  height: 38px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #e5e7eb;
  background: #fff;
}

.btn-light:hover {
  background: #f9fafb;
}
.device-card {
  background: #fff;
  border-radius: 14px;
  transition: all 0.25s ease;
  box-shadow: 0 6px 20px rgba(0,0,0,0.06);
  margin-bottom: 24px;
}

.device-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 14px 35px rgba(0,0,0,0.12);
}

.status-pill {
  padding: 4px 10px;
  font-size: 12px;
  border-radius: 999px;
  font-weight: 600;
}

.status-pill.online {
  background: rgba(34,197,94,0.15);
  color: #16a34a;
}

.status-pill.offline {
  background: rgba(239,68,68,0.15);
  color: #dc2626;
}
.device-meta {
  font-size: 13px;
  color: #6b7280; /* muted gray */
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 4px;
}

.meta-item i {
  font-size: 13px;
  opacity: 0.8;
}
